{
  "name": "etv-next-scheduler",
  "version": "0.1.0",
  "license": "Zlib",
  "description": "A scheduler and web UI for ErsatzTV next: builds channel playouts and the TV guide from your media library, and runs ErsatzTV next for you.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "server": "node scripts/launcher.mjs",
    "dev:server": "node --watch dist/server/main.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "build:all": "npm run build && npm run web:build",
    "ui": "npm run build && npm run web:build && node scripts/launcher.mjs",
    "test-instance": "node scripts/test-instance.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.11.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.2"
  }
}
