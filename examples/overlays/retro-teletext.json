{
  "category": "Retro",
  "name": "Teletext page",
  "description": "A blocky teletext-style page: what's on now and the next three, every half hour.",
  "timing": {
    "mode": "every",
    "everyMinutes": 30,
    "showSeconds": 12,
    "offsetSeconds": 600
  },
  "layers": [
    {
      "type": "box",
      "x": 240,
      "y": 160,
      "w": 1440,
      "h": 760,
      "color": "#000000",
      "opacity": 92,
      "anim": {
        "in": {
          "type": "fade",
          "duration": 0.2,
          "delay": 0
        },
        "out": {
          "type": "fade",
          "duration": 0.3,
          "delay": 0
        }
      }
    },
    {
      "type": "box",
      "x": 240,
      "y": 160,
      "w": 1440,
      "h": 70,
      "color": "#1d4ed8",
      "anim": {
        "in": {
          "type": "fade",
          "duration": 0.1,
          "delay": 0.1
        },
        "out": {
          "type": "fade",
          "duration": 0.3,
          "delay": 0
        }
      }
    },
    {
      "type": "text",
      "x": 270,
      "y": 170,
      "w": 1380,
      "h": 54,
      "text": "P100  {{channel}}  ·  {{number}}",
      "size": 44,
      "color": "#fde047",
      "font": "Courier New",
      "bold": true,
      "upper": true,
      "fit": true,
      "anim": {
        "in": {
          "type": "fade",
          "duration": 0.1,
          "delay": 0.2
        },
        "out": {
          "type": "fade",
          "duration": 0.3,
          "delay": 0
        }
      }
    },
    {
      "type": "text",
      "x": 270,
      "y": 270,
      "w": 1380,
      "h": 56,
      "text": "NOW   {{start_time}}  {{show}}",
      "size": 42,
      "color": "#22d3ee",
      "font": "Courier New",
      "bold": true,
      "fit": true,
      "anim": {
        "in": {
          "type": "fade",
          "duration": 0.1,
          "delay": 0.4
        },
        "out": {
          "type": "fade",
          "duration": 0.3,
          "delay": 0
